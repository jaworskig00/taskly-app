{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(npx prettier:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cd:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./backend/app/**)",
      "Edit(./frontend/src/main.tsx)",
      "Edit(./frontend/package.json)",
      "Edit(./frontend/package-lock.json)",
      "Edit(./frontend/vite.config.ts)",
      "Edit(./frontend/tsconfig.json)",
      "Edit(./backend/pyproject.toml)",
      "Edit(./backend/requirements.in)",
      "Edit(./backend/requirements.txt)",
      "Edit(./compose.yaml)",
      "Edit(./pytest.ini)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)"
    ]
  }
}
